<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SpireBridgeHarness</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2ManagedDir>$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\SpireBridge\SpireBridge.csproj" />
    <!-- Copy game assemblies next to the harness ONLY so their types can be
         resolved/JITed out-of-game (e.g. GameVersion reading the sts2
         assembly location). The bridge itself never bundles them. -->
    <Reference Include="sts2">
      <HintPath>$(Sts2ManagedDir)\sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(Sts2ManagedDir)\GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
